# Copie este arquivo para .env e preencha. O .env NÃO vai para o GitHub (.gitignore).

# Obrigatório: Discord > Configurações do canal > Integrações > Webhooks > Copiar URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/seu_id/seu_token_aqui

# Opcional: token do GitHub (Settings > Developer settings > Personal access tokens),
# usado pelo alvo "GitHub API" com autenticação Bearer. Não precisa de nenhuma permissão.
# Deixe vazio para consultar sem autenticação (limite menor de requisições).
GITHUB_TOKEN=

# Intervalo entre verificações no modo contínuo (segundos)
CHECK_INTERVAL_SECONDS=60

# Janela do relatório de uptime (--report), em horas
REPORT_HOURS=24

# Caminhos e log
TARGETS_FILE=targets.yaml
DB_PATH=data/monitor.db
LOG_LEVEL=INFO
